{
  "name": "@local/session-status-hud",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Always-on-top desktop status badge and Windows notifications for live DSH sessions.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "hud.ps1",
    "notify.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
